# PresyoWatch environment — placeholders only.
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must never be
# committed (CLAUDE.md rule 6). Variables are added here as the tasks that need them
# land; this file is deliberately minimal.

# Neon Postgres. Use the *pooled* endpoint; Neon requires TLS.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/presyowatch?sslmode=require

# Sent on every outbound request. Must identify the project and carry a reachable
# contact email so a source operator can reach a human (CLAUDE.md rule 7).
HTTP_USER_AGENT=PresyoWatch/0.1 (+https://github.com/tenzo08/presyo-watch; contact: you@example.com)

# Content-addressed raw source cache, SHA-256 keyed. Every fetched source file is
# stored here permanently and never re-fetched (CLAUDE.md rule 3). Gitignored.
RAW_CACHE_DIR=./data/cache/raw
